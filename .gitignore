# ── Build outputs ─────────────────────────────────────────
dist/
build/
*.spec.bak
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/

# ── PyInstaller ───────────────────────────────────────────
*.manifest
*.spec.log

# ── App runtime data ──────────────────────────────────────
# User history/rollback lives in ~/.local/share/cyber-clean
# Don't commit anyone's local data
*.jsonl
*.log

# ── OS junk ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*~

# ── IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.env
.venv/
.pytest_tmp/
venv/
env/

# ── Sensitive ─────────────────────────────────────────────
*.pem
*.key
secrets.py
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local validation output (keep only the small, reusable probe scripts)
validation/*
!validation/*.py
