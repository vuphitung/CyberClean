; CyberClean v3.1.1 — Inno Setup Script
; AUTO-GENERATED by build.py — do not edit VERSION here, edit version.py
; Build: Open in Inno Setup Compiler → Compile (F9)
; Download Inno Setup: https://jrsoftware.org/isinfo.php

[Setup]
AppName=CyberClean
AppVersion=3.1.1
AppPublisher=vuphitung
AppPublisherURL=https://github.com/vuphitung/CyberClean
AppSupportURL=https://github.com/vuphitung/CyberClean/issues
AppUpdatesURL=https://github.com/vuphitung/CyberClean/releases
ArchitecturesAllowed=x64
ArchitecturesInstallIn64BitMode=x64
DefaultDirName={autopf}\CyberClean
DefaultGroupName=CyberClean
AllowNoIcons=yes
OutputDir=dist
OutputBaseFilename=CyberClean_Setup_v3.1.1
SetupIconFile=assets\logo.ico
Compression=lzma
CloseApplications=yes
RestartApplications=no
AppMutex=CyberClean_Single_Instance_Lock
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
UninstallDisplayName=CyberClean
UninstallDisplayIcon={app}\CyberClean.exe
VersionInfoVersion=3.1.1.0
VersionInfoDescription=Smart Disk Cleaner
VersionInfoCompany=vuphitung
VersionInfoProductName=CyberClean

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional icons:"
Name: "pawniodriver"; Description: "Install PawnIO hardware sensor driver (required for CPU temperature)"; GroupDescription: "Hardware monitoring:"

[Dirs]
Name: "{app}"; Permissions: admins-full system-full users-readexec

[Files]
Source: "dist\CyberClean\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Shortcut trực tiếp vào .exe — không dùng schtasks
; schtasks /rl highest dễ bị Defender/EDR đánh dấu hành vi đáng ngờ
Name: "{group}\CyberClean"; Filename: "{app}\CyberClean.exe"
Name: "{group}\Uninstall CyberClean"; Filename: "{uninstallexe}"
Name: "{autodesktop}\CyberClean"; Filename: "{app}\CyberClean.exe"; Tasks: desktopicon

[Run]
; Install PawnIO CPU sensor driver if selected and bundled (silent install, skipped if already installed)
Filename: "{app}\PawnIO_setup.exe"; Parameters: "-install -silent"; StatusMsg: "Installing PawnIO CPU sensor driver..."; Tasks: pawniodriver; Check: ShouldInstallPawnIO; Flags: waituntilterminated skipifdoesntexist
; Launch app sau khi cài xong
Filename: "{app}\CyberClean.exe"; Description: "Launch CyberClean"; Flags: nowait postinstall

[Code]
function ShouldInstallPawnIO(): Boolean;
var
  Ver: String;
begin
  Result := not (RegQueryStringValue(HKLM64, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO', 'DisplayVersion', Ver) and (Length(Ver) > 0))
            and not (RegQueryStringValue(HKLM, 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\PawnIO', 'DisplayVersion', Ver) and (Length(Ver) > 0));
end;
